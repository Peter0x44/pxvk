.version 4.1
.target sm_52
.address_size 32

.global .texref probe_tex;

.visible .entry math_probe(
    .param .u32 math_probe_param_0
)
{
    .reg .u32 %out;
    .reg .u32 %r<20>;
    .reg .s32 %s<4>;
    .reg .f32 %f<20>;

    ld.param.u32 %out, [math_probe_param_0];

    mov.f32 %f1, 0f3F800000;
    mov.f32 %f2, 0f40400000;
    div.full.ftz.f32 %f3, %f1, %f2;
    mov.b32 %r1, %f3;
    st.global.u32 [%out+0], %r1;

    mov.f32 %f4, 0f00800000;
    mov.f32 %f5, 0f40000000;
    div.full.ftz.f32 %f6, %f4, %f5;
    mov.b32 %r2, %f6;
    st.global.u32 [%out+4], %r2;

    rcp.approx.ftz.f32 %f7, %f2;
    mov.b32 %r3, %f7;
    st.global.u32 [%out+8], %r3;

    sqrt.approx.ftz.f32 %f8, %f5;
    mov.b32 %r4, %f8;
    st.global.u32 [%out+12], %r4;

    mov.f32 %f9, 0f00000001;
    sqrt.approx.ftz.f32 %f10, %f9;
    mov.b32 %r5, %f10;
    st.global.u32 [%out+16], %r5;

    rsqrt.approx.ftz.f32 %f11, %f5;
    mov.b32 %r6, %f11;
    st.global.u32 [%out+20], %r6;

    mov.f32 %f12, 0f3F800001;
    mov.f32 %f13, 0f3F7FFFFE;
    mov.f32 %f14, 0fBF800000;
    fma.rn.ftz.f32 %f15, %f12, %f13, %f14;
    mov.b32 %r7, %f15;
    st.global.u32 [%out+24], %r7;

    mul.ftz.f32 %f16, %f12, %f13;
    add.ftz.f32 %f17, %f16, %f14;
    mov.b32 %r8, %f17;
    st.global.u32 [%out+28], %r8;

    mov.f32 %f18, 0fC0700000;
    cvt.rzi.ftz.s32.f32 %s1, %f18;
    mov.b32 %r9, %s1;
    st.global.u32 [%out+32], %r9;

    mov.u32 %r10, 16777217;
    cvt.rn.f32.u32 %f19, %r10;
    mov.b32 %r11, %f19;
    st.global.u32 [%out+36], %r11;

    mov.f32 %f1, 0f00000001;
    mov.f32 %f2, 0f00000000;
    add.ftz.f32 %f3, %f1, %f2;
    mov.b32 %r12, %f3;
    st.global.u32 [%out+40], %r12;

    mov.f32 %f2, 0f3F800000;
    mul.ftz.f32 %f3, %f1, %f2;
    mov.b32 %r13, %f3;
    st.global.u32 [%out+44], %r13;

    mov.f32 %f4, 0f7FC00000;
    min.ftz.f32 %f5, %f4, %f2;
    mov.b32 %r14, %f5;
    st.global.u32 [%out+48], %r14;

    max.ftz.f32 %f6, %f4, %f2;
    mov.b32 %r15, %f6;
    st.global.u32 [%out+52], %r15;

    ret;
}

.visible .entry barrier_probe(
    .param .u32 barrier_probe_param_0
)
{
    .shared .align 4 .u32 values[64];
    .reg .u32 %out;
    .reg .u32 %thread;
    .reg .u32 %value;
    .reg .u32 %neighbor;
    .reg .u32 %offset;
    .reg .u32 %address;

    ld.param.u32 %out, [barrier_probe_param_0];
    mov.u32 %thread, %tid.x;
    add.u32 %value, %thread, 1;
    shl.b32 %offset, %thread, 2;
    mov.u32 %address, values;
    add.u32 %address, %address, %offset;
    st.shared.u32 [%address], %value;
    bar.sync 0;
    add.u32 %neighbor, %thread, 1;
    and.b32 %neighbor, %neighbor, 63;
    shl.b32 %offset, %neighbor, 2;
    mov.u32 %address, values;
    add.u32 %address, %address, %offset;
    ld.shared.u32 %value, [%address];
    shl.b32 %offset, %thread, 2;
    add.u32 %address, %out, %offset;
    st.global.u32 [%address], %value;
    ret;
}

.visible .entry texture_probe(
    .param .u32 texture_probe_param_0
)
{
    .reg .u32 %out;
    .reg .u32 %thread;
    .reg .s32 %coord;
    .reg .u32 %address;
    .reg .u32 %r<5>;

    ld.param.u32 %out, [texture_probe_param_0];
    mov.u32 %thread, %tid.x;
    sub.s32 %coord, %thread, 2;
    tex.1d.v4.u32.s32 {%r1, %r2, %r3, %r4}, [probe_tex, {%coord}];
    mad.lo.s32 %address, %thread, 16, %out;
    st.global.v4.u32 [%address], {%r1, %r2, %r3, %r4};
    ret;
}
