#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer OracleBuffer {
    uint words[];
};

shared uint shared_values[64];

const uint MEMORY_INPUT = 0u;
const uint MEMORY_OUTPUT = 1u;
const uint MATH_OUTPUT = 16u;
const uint BARRIER_OUTPUT = 64u;
const uint TEXTURE_INPUT = 160u;
const uint TEXTURE_OUTPUT = 256u;
const uint TEXTURE_FLOAT_INPUT = 320u;
const uint TEXTURE_FLOAT_OUTPUT = 384u;
const uint LOCAL_OUTPUT = 448u;

uint flush_ftz_bits(uint bits)
{
    uint magnitude = bits & 0x7fffffffu;
    bool subnormal = magnitude != 0u && magnitude < 0x00800000u;
    return subnormal ? (bits & 0x80000000u) : bits;
}

float ftz_input(float value)
{
    return uintBitsToFloat(flush_ftz_bits(floatBitsToUint(value)));
}

uint ftz_output(float value)
{
    return flush_ftz_bits(floatBitsToUint(value));
}

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint local_values[4];
    uint local_index = (tid * 3u) & 3u;
    local_values[local_index] = 0x5a000000u + tid;
    words[LOCAL_OUTPUT + tid] = local_values[local_index];

    if (tid == 0u) {
        words[MEMORY_OUTPUT] = (words[MEMORY_INPUT] ^ 0xa5a55a5au) + 0x10203040u;

        float one = uintBitsToFloat(0x3f800000u);
        float three = uintBitsToFloat(0x40400000u);
        float two = uintBitsToFloat(0x40000000u);
        float minimum_normal = uintBitsToFloat(0x00800000u);
        float minimum_subnormal = uintBitsToFloat(0x00000001u);

        words[MATH_OUTPUT + 0u] = ftz_output(one / three);
        words[MATH_OUTPUT + 1u] = ftz_output(minimum_normal / two);
        words[MATH_OUTPUT + 2u] = ftz_output(one / three);
        words[MATH_OUTPUT + 3u] = ftz_output(sqrt(two));
        words[MATH_OUTPUT + 4u] = ftz_output(sqrt(ftz_input(minimum_subnormal)));
        words[MATH_OUTPUT + 5u] = ftz_output(inversesqrt(two));

        float fma_a = uintBitsToFloat(0x3f800001u);
        float fma_b = uintBitsToFloat(0x3f7ffffeu);
        float negative_one = uintBitsToFloat(0xbf800000u);
        precise float fused = fma(fma_a, fma_b, negative_one);
        precise float product = fma_a * fma_b;
        precise float separate = product + negative_one;
        words[MATH_OUTPUT + 6u] = ftz_output(fused);
        words[MATH_OUTPUT + 7u] = ftz_output(separate);

        float negative_three_point_seven_five = uintBitsToFloat(0xc0700000u);
        words[MATH_OUTPUT + 8u] = uint(int(trunc(negative_three_point_seven_five)));
        words[MATH_OUTPUT + 9u] = floatBitsToUint(float(16777217u));

        float normalized_subnormal = ftz_input(minimum_subnormal);
        words[MATH_OUTPUT + 10u] = ftz_output(normalized_subnormal + 0.0);
        words[MATH_OUTPUT + 11u] = ftz_output(normalized_subnormal * one);

        float nan_value = uintBitsToFloat(0x7fc00000u);
        words[MATH_OUTPUT + 12u] = floatBitsToUint(isnan(nan_value) ? one : min(nan_value, one));
        words[MATH_OUTPUT + 13u] = floatBitsToUint(isnan(nan_value) ? one : max(nan_value, one));
    }

    shared_values[tid] = tid + 1u;
    memoryBarrierShared();
    barrier();
    words[BARRIER_OUTPUT + tid] = shared_values[(tid + 1u) & 63u];

    if (tid < 12u) {
        int coordinate = int(tid) - 2;
        bool in_bounds = coordinate >= 0 && coordinate < 8;
        uint safe_coordinate = in_bounds ? uint(coordinate) : 0u;
        uint input_index = TEXTURE_INPUT + safe_coordinate * 4u;
        uint output_index = TEXTURE_OUTPUT + tid * 4u;
        for (uint component = 0u; component < 4u; ++component) {
            words[output_index + component] =
                in_bounds ? words[input_index + component] : 0u;
        }

        uint float_input_index = TEXTURE_FLOAT_INPUT + safe_coordinate * 4u;
        uint float_output_index = TEXTURE_FLOAT_OUTPUT + tid * 4u;
        for (uint component = 0u; component < 4u; ++component) {
            words[float_output_index + component] =
                in_bounds ? words[float_input_index + component] : 0u;
        }
    }
}
