.version 4.1
.target sm_52
.address_size 32

.visible .entry cfg_probe(
    .param .u32 cfg_probe_param_0,
    .param .u32 cfg_probe_param_1
)
{
    .reg .pred %p<3>;
    .reg .u32 %r<8>;
    .reg .s64 %rd<4>;

    ld.param.u32 %r1, [cfg_probe_param_0];
    ld.param.u32 %r2, [cfg_probe_param_1];
    mov.u32 %r3, %tid.x;
    setp.ge.u32 %p1, %r3, %r2;
    @%p1 bra done;
    mov.u32 %r4, 0;
loop:
    add.u32 %r4, %r4, 1;
    setp.gt.u32 %p2, %r2, %r4;
    @%p2 bra loop;
    shl.b32 %r5, %r3, 2;
    add.u32 %r6, %r1, %r5;
    st.global.u32 [%r6], %r4;
done:
    ret;
}
