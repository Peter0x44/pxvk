.version 4.1
.target sm_52
.address_size 32

.extern .shared .align 4 .b8 sharedValues[];

.visible .entry shared_storage_grid_probe(
    .param .u32 shared_storage_grid_probe_param_0
)
{
    .reg .pred %p<2>;
    .reg .u32 %r<8>;

    ld.param.u32 %r1, [shared_storage_grid_probe_param_0];
    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    add.u32 %r4, %r3, 7;
    setp.ne.s32 %p1, %r2, 0;
    @%p1 bra barrier;
    st.shared.u32 [sharedValues], %r4;
barrier:
    bar.sync 0;
    @%p1 bra done;
    ld.shared.u32 %r5, [sharedValues];
    shl.b32 %r6, %r3, 2;
    add.u32 %r7, %r1, %r6;
    st.global.u32 [%r7], %r5;
done:
    ret;
}
